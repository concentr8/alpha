{
  "name": "concentr8",
  "productName": "Concentr8",
  "version": "1.1.0",
  "private": true,
  "description": "Concentr8 desktop app: Jack's web app in a window.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.concentr8.mac",
    "productName": "Concentr8",
    "directories": { "output": "release" },
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../frontend", "to": "frontend" }],
    "artifactName": "Concentr8-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Concentr8 uses the microphone for voice input in the chat and the body-double room.",
        "NSCameraUsageDescription": "Concentr8 uses the camera in the body-double room."
      },
      "icon": "build/icon.png"
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "linux": { "target": [{ "target": "AppImage", "arch": ["x64"] }], "category": "Utility", "icon": "build/icon.png" }
  }
}
