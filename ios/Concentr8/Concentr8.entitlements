<?xml version="1.0" encoding="UTF-8"?>
<!-- Purpose: rights of the Concentr8 app: Family Controls (Screen Time) and the shared App Group. -->
<!-- Called by: Xcode, through CODE_SIGN_ENTITLEMENTS in ios/project.yml. Calls: nothing. -->
<!-- TODO: signing is done by a human in Xcode (team, provisioning, Family Controls for this bundle ID). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.family-controls</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.concentr8.ios</string>
	</array>
</dict>
</plist>
