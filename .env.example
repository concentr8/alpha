# Copy to backend/.env and fill in. backend/.env is ignored by git.
# Only names live here. Never put real keys into this file.

APP_ENV=development
# Browser origins allowed to call the API (the frontend's address)
ALLOWED_ORIGINS=http://localhost:8080

# Claude (Anthropic API): writes the call script from the user's task
ANTHROPIC_API_KEY=

# Option A: Dial (phone numbers + voice calls for AI agents)
DIAL_API_KEY=
DIAL_FROM_NUMBER_ID=

# Option B: ElevenLabs agent + Twilio phone number
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Voice used to read meditations aloud (pick one in ElevenLabs, copy its id)
ELEVENLABS_VOICE_ID=
# Optional: model ids. Leave the lines out to use the defaults from src/config.py
# (an empty value here would override the default with nothing).
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2
# Optional spending limits (defaults in src/config.py, cautious guesses):
# VOICE_REQUESTS_PER_VISITOR_PER_HOUR=60
# VOICE_DAILY_SPEECH_CHARACTERS=20000
# VOICE_DAILY_TRANSCRIPTIONS=200
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Which provider places calls: dial | elevenlabs | mock
VOICE_PROVIDER=mock

# Database (placeholder until the data plan is decided)
DATABASE_URL=sqlite:///./articul8.db
